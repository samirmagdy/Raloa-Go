rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function paidPlan(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.plan in ['pro', 'studio'];
    }
    function validEmail(value) {
      return value is string && value.size() <= 320 && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    function validProfile(data) {
      return data.uid is string && data.email is string && data.email.size() <= 320
        && data.plan in ['free', 'pro', 'studio'] && data.isYearly is bool
        && data.referralsCount is number && data.referralsCount >= 0
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'plan', 'isYearly', 'billingStatus', 'handle', 'referralsCount', 'referredBy', 'referralStatus', 'referralRewards', 'referralProUntil', 'verifiedCreator', 'customDomainPerkUnlocked', 'createdAt', 'updatedAt', 'stripeCustomerId', 'stripeSubscriptionId']);
    }
    function validSite(data, userId) {
      return data.username is string && data.username.size() >= 3 && data.username.size() <= 30
        && data.templateId is string && data.templateId.size() <= 100
        && data.displayName is string && data.displayName.size() <= 120
        && data.bio is string && data.bio.size() <= 2000
        && data.links is list && data.links.size() <= 100 && data.isPublished is bool
        && data.keys().hasOnly(['id', 'userId', 'username', 'displayName', 'role', 'bio', 'avatar', 'coverImage', 'templateId', 'bgStyle', 'themeMode', 'links', 'isPublished', 'accentColor', 'surfaceColor', 'cardRadius', 'cardShadow', 'borderStyle', 'customDomain', 'metaTitle', 'metaDescription', 'hidePoweredBy', 'sensitiveWarning', 'ga4Id', 'metaPixelId', 'webhookUrl', 'updatedAt'])
        && (!('userId' in data) || data.userId == userId)
        && (get(/databases/$(database)/documents/users/$(userId)).data.plan != 'free' || data.links.size() <= 10)
        && (paidPlan(userId) || (!('customDomain' in data) || data.customDomain == ''))
        && (paidPlan(userId) || (!('hidePoweredBy' in data) || data.hidePoweredBy == false))
        && (paidPlan(userId) || (!('ga4Id' in data) || data.ga4Id == ''))
        && (paidPlan(userId) || (!('metaPixelId' in data) || data.metaPixelId == ''))
        && (paidPlan(userId) || (!('webhookUrl' in data) || data.webhookUrl == ''));
    }

    match /users/{userId} {
      allow read: if owner(userId);
      allow create: if owner(userId) && request.resource.data.uid == userId && request.resource.data.plan == 'free'
        && !request.resource.data.keys().hasAny(['billingStatus', 'stripeCustomerId', 'stripeSubscriptionId'])
        && validProfile(request.resource.data);
      allow update: if owner(userId) && validProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'isYearly', 'billingStatus', 'stripeCustomerId', 'stripeSubscriptionId', 'referralsCount', 'referralRewards', 'referralProUntil', 'verifiedCreator', 'customDomainPerkUnlocked', 'referredBy', 'referralStatus']);
      allow delete: if false;

      match /sites/{siteId} {
        allow read: if owner(userId);
        allow create, update: if owner(userId) && validSite(request.resource.data, userId);
        allow delete: if owner(userId);
      }
      match /referrals/{referralId} {
        allow read: if owner(userId);
        allow create: if owner(userId) && request.resource.data.status == 'invited'
          && validEmail(request.resource.data.invitedEmail)
          && request.resource.data.keys().hasOnly(['invitedEmail', 'status', 'createdAt']);
        allow update, delete: if false;
      }
    }

    match /referral_codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && code.size() >= 3 && code.size() <= 50
        && request.resource.data.keys().hasOnly(['userId', 'updatedAt']);
      allow update, delete: if false;
    }
    match /contacts/{contactId} {
      allow create: if validEmail(request.resource.data.email)
        && (('name' in request.resource.data && request.resource.data.name is string) || ('fullName' in request.resource.data && request.resource.data.fullName is string))
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 5000
        && request.resource.data.keys().hasOnly(['id', 'name', 'fullName', 'email', 'subject', 'message', 'createdAt']);
      allow read, update, delete: if false;
    }
    match /newsletter_subscribers/{subscriberId} {
      allow create: if validEmail(request.resource.data.email) && request.resource.data.keys().hasOnly(['email', 'createdAt']);
      allow read, update, delete: if false;
    }
    match /bookings/{bookingId} { allow read, write: if false; }
    match /orders/{orderId} { allow read, write: if false; }
    match /page_views/{viewId} {
      allow create: if request.resource.data.path is string && request.resource.data.path.size() <= 500
        && request.resource.data.keys().hasOnly(['path', 'timestamp', 'userAgent']);
      allow read, update, delete: if false;
    }
    match /link_clicks/{clickId} {
      allow create: if request.resource.data.linkId is string && request.resource.data.linkId.size() <= 200
        && request.resource.data.url is string && request.resource.data.url.size() <= 2000
        && request.resource.data.keys().hasOnly(['linkId', 'url', 'siteHandle', 'timestamp']);
      allow read, update, delete: if false;
    }
    match /custom_domains/{domainId} { allow read, write: if false; }
    match /stripe_events/{eventId} { allow read, write: if false; }
  }
}
