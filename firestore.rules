rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // User's mini-sites
      match /sites/{siteId} {
        allow read: if isOwner(userId) || resource.data.isPublished == true;
        allow write: if isOwner(userId);
      }

      // User's referrals subcollection
      match /referrals/{referralId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Contact messages
    match /contacts/{contactId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.message is string;
      allow read, update, delete: if false;
    }

    // Newsletter subscriptions
    match /newsletter_subscribers/{subscriberId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read, update, delete: if false;
    }

    // Bookings / appointments
    match /bookings/{bookingId} {
      allow create: if request.resource.data.clientEmail is string
                    && request.resource.data.date is string;
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }

    // Orders / shop purchases
    match /orders/{orderId} {
      allow create: if request.resource.data.itemTitle is string;
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }

    // Page views & link click telemetry
    match /page_views/{viewId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    match /link_clicks/{clickId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
