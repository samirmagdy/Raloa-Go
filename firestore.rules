rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function reservedHandle(userId, handle) {
      return exists(/databases/$(database)/documents/handles/$(handle))
        && get(/databases/$(database)/documents/handles/$(handle)).data.userId == userId;
    }
    function paidPlan(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.plan in ['pro', 'studio'];
    }
    function studioPlan(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.plan == 'studio';
    }
    function premiumTemplate(templateId) {
      return !(templateId in ['elena', 'mateo', 'dr-ahmed', 'fitlife', 'wander', 'savor']);
    }
    function validDesign(data, userId) {
      return (paidPlan(userId) || (!('bgStyle' in data) || data.bgStyle in ['signature', 'minimal']))
        && (paidPlan(userId) || (!('cardRadius' in data) || data.cardRadius in ['subtle', 'rounded']))
        && (paidPlan(userId) || (!('cardShadow' in data) || data.cardShadow in ['none', 'subtle']))
        && (paidPlan(userId) || (!('borderStyle' in data) || data.borderStyle in ['none', 'thin']));
    }
    function validBlockForPlan(block, userId) {
      return studioPlan(userId) || !('type' in block) || block.type in ['link', 'gallery', 'booking', 'shop'];
    }
    function validEmail(value) {
      return value is string && value.size() <= 320 && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    function validProfile(data) {
      return data.uid is string && (data.email == null || (data.email is string && data.email.size() <= 320))
        && data.handle is string && data.handle.matches('^[a-z0-9_-]{3,30}$')
        && data.plan in ['free', 'pro', 'studio'] && data.isYearly is bool
        && data.referralsCount is number && data.referralsCount >= 0
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'bio', 'pronouns', 'location', 'website', 'locale', 'timeZone', 'notificationPreferences', 'privacyPreferences', 'plan', 'isYearly', 'billingStatus', 'handle', 'referralsCount', 'referredBy', 'referralStatus', 'referralRewards', 'referralProUntil', 'verifiedCreator', 'customDomainPerkUnlocked', 'createdAt', 'updatedAt', 'stripeCustomerId', 'stripeSubscriptionId', 'subscriptionCurrentPeriodEnd']);
    }
    function validLink(link) {
      return link is map
        && link.keys().hasOnly(['id', 'title', 'titleAr', 'subtitle', 'subtitleAr', 'url', 'thumbnail', 'galleryItems', 'type'])
        && link.id is string && link.id.size() <= 200
        && link.title is string && link.title.size() <= 200
        && link.url is string && link.url.size() <= 2000
        && link.url.matches('^(https?://|mailto:|tel:|#[A-Za-z0-9_-]{1,80}$)')
        && (!('titleAr' in link) || link.titleAr is string)
        && (!('subtitle' in link) || link.subtitle is string)
        && (!('subtitleAr' in link) || link.subtitleAr is string)
        && (!('thumbnail' in link) || link.thumbnail is string)
        && (!('galleryItems' in link) || link.galleryItems is list && link.galleryItems.size() >= 1 && link.galleryItems.size() <= 50 && link.galleryItems.all(item, validGalleryItem(item)))
        && (!('type' in link) || link.type != 'gallery' || ('galleryItems' in link && link.galleryItems is list && link.galleryItems.size() >= 1))
        && (!('type' in link) || link.type in ['link', 'gallery', 'booking', 'shop']);
    }
    function validGalleryItem(item) {
      return item is map
        && item.keys().hasOnly(['id', 'src', 'thumbnail', 'alt', 'caption', 'type'])
        && item.id is string && item.id.size() <= 128
        && item.src is string && item.src.size() <= 4000 && item.src.matches('^https?://')
        && (!('thumbnail' in item) || item.thumbnail is string && item.thumbnail.size() <= 4000 && item.thumbnail.matches('^https?://'))
        && (!('alt' in item) || item.alt is string && item.alt.size() <= 300)
        && (!('caption' in item) || item.caption is string && item.caption.size() <= 500)
        && (!('type' in item) || item.type in ['image', 'video']);
    }
    function validBookingService(service) {
      return service is map
        && service.keys().hasOnly(['id', 'name', 'description', 'durationMinutes', 'bufferMinutes'])
        && service.id is string && service.id.matches('^[a-z0-9_-]{1,64}$')
        && service.name is string && service.name.size() <= 120
        && (!('description' in service) || service.description is string && service.description.size() <= 500)
        && service.durationMinutes is number && service.durationMinutes >= 15 && service.durationMinutes <= 480
        && (!('bufferMinutes' in service) || service.bufferMinutes is number && service.bufferMinutes >= 0 && service.bufferMinutes <= 120);
    }
    function validBookingConfig(config) {
      return config is map
        && config.keys().hasOnly(['enabled', 'timezone', 'services', 'weeklyAvailability', 'blackoutDates', 'minNoticeMinutes', 'bookingWindowDays', 'bufferMinutes', 'maxBookingsPerDay', 'calendarProvider'])
        && config.enabled is bool
        && config.timezone is string && config.timezone.size() <= 100
        && config.services is list && config.services.size() <= 50 && config.services.all(service, validBookingService(service))
        && config.weeklyAvailability is map
        && config.blackoutDates is list && config.blackoutDates.size() <= 366
        && config.minNoticeMinutes is number && config.minNoticeMinutes >= 0 && config.minNoticeMinutes <= 10080
        && config.bookingWindowDays is number && config.bookingWindowDays >= 1 && config.bookingWindowDays <= 365
        && config.bufferMinutes is number && config.bufferMinutes >= 0 && config.bufferMinutes <= 120
        && config.maxBookingsPerDay is number && config.maxBookingsPerDay >= 1 && config.maxBookingsPerDay <= 100
        && (!('calendarProvider' in config) || config.calendarProvider in ['none', 'google', 'outlook']);
    }
    function validSite(data, userId) {
      return data.username is string && data.username.matches('^[a-z0-9_-]{3,30}$')
        && data.templateId is string && data.templateId.size() <= 100
        && data.displayName is string && data.displayName.size() <= 120
        && data.bio is string && data.bio.size() <= 2000
        && data.links is list && data.links.size() <= 100 && data.isPublished is bool
        && data.keys().hasOnly(['id', 'userId', 'username', 'displayName', 'role', 'bio', 'avatar', 'coverImage', 'templateId', 'bgStyle', 'themeMode', 'links', 'isPublished', 'accentColor', 'surfaceColor', 'cardRadius', 'cardShadow', 'borderStyle', 'customDomain', 'metaTitle', 'metaDescription', 'hidePoweredBy', 'sensitiveWarning', 'ga4Id', 'metaPixelId', 'webhookUrl', 'bookingConfig', 'updatedAt'])
        && (!('bookingConfig' in data) || validBookingConfig(data.bookingConfig))
        && (!premiumTemplate(data.templateId) || paidPlan(userId))
        && validDesign(data, userId)
        && data.links.all(link, validBlockForPlan(link, userId))
        && (!('userId' in data) || data.userId == userId)
        && (get(/databases/$(database)/documents/users/$(userId)).data.plan != 'free' || data.links.size() <= 10)
        && (paidPlan(userId) || (!('customDomain' in data) || data.customDomain == ''))
        && (paidPlan(userId) || (!('hidePoweredBy' in data) || data.hidePoweredBy == false))
        && (paidPlan(userId) || (!('ga4Id' in data) || data.ga4Id == ''))
        && (paidPlan(userId) || (!('metaPixelId' in data) || data.metaPixelId == ''))
        && (paidPlan(userId) || (!('webhookUrl' in data) || data.webhookUrl == ''));
    }

    match /users/{userId} {
      allow read: if owner(userId);
      allow create: if owner(userId) && request.resource.data.uid == userId && request.resource.data.plan == 'free'
        && !request.resource.data.keys().hasAny(['billingStatus', 'stripeCustomerId', 'stripeSubscriptionId'])
        && reservedHandle(userId, request.resource.data.handle)
        && validProfile(request.resource.data);
      allow update: if owner(userId) && validProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'isYearly', 'billingStatus', 'stripeCustomerId', 'stripeSubscriptionId', 'referralsCount', 'referralRewards', 'referralProUntil', 'verifiedCreator', 'customDomainPerkUnlocked', 'referredBy', 'referralStatus', 'handle']);
      allow delete: if false;

      match /sites/{siteId} {
        allow read: if owner(userId);
        allow create, update: if owner(userId) && validSite(request.resource.data, userId);
        allow delete: if owner(userId);
      }
      match /referrals/{referralId} {
        allow read: if owner(userId);
        allow create: if owner(userId) && request.resource.data.status == 'invited'
          && validEmail(request.resource.data.invitedEmail)
          && request.resource.data.keys().hasOnly(['invitedEmail', 'status', 'createdAt']);
        allow update, delete: if false;
      }
    }

    match /referral_codes/{code} {
      allow read, write: if false;
    }
    match /contacts/{contactId} {
      allow read, write: if false;
    }
    match /newsletter_subscribers/{subscriberId} {
      allow read, write: if false;
    }
    match /bookings/{bookingId} { allow read, write: if false; }
    match /orders/{orderId} { allow read, write: if false; }
    match /page_views/{viewId} {
      allow read, write: if false;
    }
    match /link_clicks/{clickId} {
      allow read, write: if false;
    }
    match /custom_domains/{domainId} { allow read, write: if false; }
    match /stripe_events/{eventId} { allow read, write: if false; }
    match /account_deletion_requests/{requestId} { allow read, write: if false; }
    match /sessions/{sessionId} { allow read, write: if false; }
  }
}
