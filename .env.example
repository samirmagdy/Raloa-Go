# GEMINI_API_KEY: Optional. Required only if AI generation is enabled.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# Next.js web boundary. Public values may be exposed to browser bundles.
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_RELEASE_ID="local"
NEXT_PUBLIC_APP_ENV="development"
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Production loads managed secrets from Secret Manager. Keep this false for local development only.
SECRET_MANAGER_ENABLED="false"
SECRET_MANAGER_PROJECT_ID=""
# Secret Manager secret names default to the environment variable name. The
# following values must never be placed in this file or a client-visible env:
# AUTH_SESSION_SECRET, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, CLOUDFLARE_API_TOKEN, provider client secrets,
# and RESEND_API_KEY. `INTEGRATION_KMS_KEY_NAME` is a non-secret KMS key resource.
# Secret manager references can override names with SECRET_MANAGER_SECRET_<NAME>.
AUTH_SESSION_SECRET=""
# Separate 32+ character key used to encrypt OAuth access tokens at rest.
INTEGRATION_ENCRYPTION_KEY=""
INTEGRATION_KMS_KEY_NAME=""
# Keep false/omitted outside local development and automated tests.
LOCAL_AUTH_ENABLED="false"
ENABLE_DEMO_FIXTURES="false"
# Number of trusted reverse-proxy hops. Cloud Run/Cloudflare deployments must set this explicitly.
TRUSTED_PROXY_HOPS="1"

# VITE_ANALYTICS_ENDPOINT: Optional endpoint URL to report Core Web Vitals (FCP, LCP) in production.
VITE_ANALYTICS_ENDPOINT=""

# Server runtime and Firebase Admin access. Production also requires Cloud Run's
# K_SERVICE or a valid GOOGLE_APPLICATION_CREDENTIALS file at startup.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIRESTORE_DATABASE_ID="migration-only-source-database"
# Firebase Storage bucket used by the server-side media processor.
FIREBASE_STORAGE_BUCKET="migration-only-source-bucket"
FIREBASE_ADMIN_ENABLED="false"
FIREBASE_ADMIN_CREDENTIAL_MODE="workload_identity"
# Browser-safe Firebase Auth configuration only. Never place server credentials here.
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-web-app-id"

# Local PostgreSQL target only. Firestore remains the application datastore.
POSTGRES_ENABLED="false"
POSTGRES_DATABASE_URL="postgresql://your-user:your-password@127.0.0.1:5432/raloa_dev"
POSTGRES_MIGRATION_DATABASE_URL=""
POSTGRES_SSL="false"
POSTGRES_POOL_MAX="10"
POSTGRES_POOL_MIN="0"
POSTGRES_CONNECTION_TIMEOUT_MS="5000"
POSTGRES_IDLE_TIMEOUT_MS="10000"
POSTGRES_APPLICATION_NAME="raloa-local"
POSTGRES_APPLICATION_DATASTORE_ONLY="false"
SITES_POSTGRES_AUTHORITATIVE="false"
# Test-only database. Never point this at staging or production.
POSTGRES_TEST_DATABASE_URL="postgresql://your-test-user:your-test-password@127.0.0.1:5434/raloa_test"
POSTGRES_TEST_SSL="false"
POSTGRES_TEST_POOL_MAX="2"

# Stripe Billing. Keep all Stripe secrets server-side.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
STRIPE_PRICE_STUDIO_MONTHLY="price_..."
STRIPE_PRICE_STUDIO_YEARLY="price_..."

# Cloudflare for SaaS custom hostnames.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_ACCOUNT_ID=""

# Cloudflare R2 server-only configuration. Use Secret Manager for access keys.
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_BUCKET="your-r2-bucket"
CLOUDFLARE_R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_PUBLIC_BASE_URL="https://cdn.your-domain.example"

# Optional error monitoring.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
RELEASE_ID="local"
APP_ENV="development"

# Cloud Tasks. Prefer service-account/OIDC identity; use CLOUD_TASKS_AUTH_TOKEN only for a controlled internal fallback.
CLOUD_TASKS_PROJECT_ID="your-gcp-project-id"
CLOUD_TASKS_LOCATION="europe-west1"
CLOUD_TASKS_QUEUE="raloa-local"
CLOUD_TASKS_WORKER_URL="https://worker.your-domain.example"
CLOUD_TASKS_SERVICE_ACCOUNT="worker@your-gcp-project-id.iam.gserviceaccount.com"
CLOUD_TASKS_OIDC_AUDIENCE="https://worker.your-domain.example"
CLOUD_TASKS_AUTH_TOKEN=""

# Enable only when the corresponding provider is configured in the deployment.
ENABLE_GOOGLE_CALENDAR="false"
ENABLE_MICROSOFT_CALENDAR="false"

# Migration-only configuration. Never load these into the application runtime.
FIRESTORE_SOURCE_PROJECT_ID="source-firebase-project-id"
FIRESTORE_SOURCE_DATABASE_ID="(default)"
FIREBASE_STORAGE_SOURCE_BUCKET="source-project.firebasestorage.app"
FIRESTORE_ARCHIVE_URI="gs://immutable-archive-bucket/firestore/2026-09-28"
FIRESTORE_ARCHIVE_MANIFEST="gs://immutable-archive-bucket/firestore/2026-09-28/manifest.json"
FIRESTORE_RECONCILIATION_REPORT=""
MEDIA_SOURCE_MANIFEST=""
MEDIA_TARGET_MANIFEST=""
MIGRATION_BATCH_SIZE="100"
MIGRATION_DRY_RUN="true"

# Technical enforcement flags only. These never replace signed approval artifacts or reconciliation evidence.
FIRESTORE_AUTHORITY_CUTOVER_APPROVED="false"
FIRESTORE_DECOMMISSION_APPROVED="false"
AUTHORITY_CUTOVER_APPROVAL_FILE=""
AUTHORITY_CUTOVER_APPROVAL_PUBLIC_KEY=""
DECOMMISSION_APPROVAL_FILE=""
DECOMMISSION_APPROVAL_PUBLIC_KEY=""
RECONCILIATION_ARTIFACT_FILE=""
RECONCILIATION_ARTIFACT_SHA256=""

# Optional booking notifications and calendar outbox workers.
# Without these values, booking records are still persisted safely and jobs remain pending for later delivery.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="bookings@your-domain.example"
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI=""
MICROSOFT_CALENDAR_CLIENT_ID=""
MICROSOFT_CALENDAR_CLIENT_SECRET=""
MICROSOFT_CALENDAR_REDIRECT_URI=""

# GitHub social integration (server-only OAuth credentials).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_OAUTH_REDIRECT_URI="https://your-domain.example/api/integrations/github/callback"
