{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raloa-staging-jobs-consumer",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "queues": {
    "consumers": [
      {
        "queue": "raloa-staging-jobs",
        "max_batch_size": 25,
        "max_batch_timeout": 10,
        "max_retries": 5,
        "dead_letter_queue": "raloa-staging-jobs-dlq"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ANALYTICS_RAW",
      "bucket_name": "raloa-staging-analytics"
    }
  ],
  "vars": {
    "APPLICATION_WORKER_URL": "",
    "INTERNAL_WORKER_TOKEN": ""
  }
}
