{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3001",
          "https://staging.example.raloa.app"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Content-Type", "Content-Length", "x-amz-content-sha256"],
        "exposeHeaders": ["ETag"]
      },
      "maxAgeSeconds": 3600
    }
  ]
}
