rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function accountPlan(userId) {
      return get(/databases/(default)/documents/users/$(userId)).data.plan;
    }
    function maxAvatarBytes(userId) {
      return accountPlan(userId) == 'studio' ? 52428800 : accountPlan(userId) == 'pro' ? 26214400 : 5242880;
    }
    match /users/{userId}/avatar {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= maxAvatarBytes(userId)
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
