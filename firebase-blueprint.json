{
  "schemaVersion": "1.0",
  "entities": {
    "users": {
      "collectionName": "users",
      "path": "users/{userId}",
      "description": "User account profile with plan status, settings and metadata",
      "fields": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "Avatar image URL" },
        "plan": { "type": "string", "description": "Subscription tier: free, pro, or studio" },
        "isYearly": { "type": "boolean", "description": "Whether the plan is billed yearly" },
        "referralsCount": { "type": "number", "description": "Number of successful referral signups" },
        "createdAt": { "type": "timestamp", "description": "Account registration timestamp" },
        "updatedAt": { "type": "timestamp", "description": "Last profile update timestamp" }
      },
      "subcollections": {
        "sites": {
          "collectionName": "sites",
          "path": "users/{userId}/sites/{siteId}",
          "description": "User's customized mini-sites and bio links",
          "fields": {
            "id": { "type": "string", "description": "Site ID" },
            "userId": { "type": "string", "description": "Owner user UID" },
            "username": { "type": "string", "description": "Handle/slug (e.g. alex)" },
            "title": { "type": "string", "description": "Display title or name" },
            "bio": { "type": "string", "description": "Bio description" },
            "templateId": { "type": "string", "description": "Selected template design ID" },
            "avatarUrl": { "type": "string", "description": "Profile picture URL" },
            "links": { "type": "array", "description": "Array of custom link buttons" },
            "socialLinks": { "type": "array", "description": "Array of social icons" },
            "products": { "type": "array", "description": "Store items or digital downloads" },
            "isPublished": { "type": "boolean", "description": "Whether site is live" },
            "updatedAt": { "type": "timestamp", "description": "Last edit timestamp" }
          }
        },
        "referrals": {
          "collectionName": "referrals",
          "path": "users/{userId}/referrals/{referralId}",
          "description": "Referral invites and reward milestones",
          "fields": {
            "id": { "type": "string", "description": "Referral record ID" },
            "invitedEmail": { "type": "string", "description": "Referred user email" },
            "status": { "type": "string", "description": "joined, verified, rewarded" },
            "createdAt": { "type": "timestamp", "description": "Referral date" }
          }
        }
      }
    },
    "contacts": {
      "collectionName": "contacts",
      "path": "contacts/{contactId}",
      "description": "Contact inquiries submitted by visitors or users",
      "fields": {
        "name": { "type": "string", "description": "Sender name" },
        "email": { "type": "string", "description": "Sender email" },
        "subject": { "type": "string", "description": "Inquiry subject" },
        "message": { "type": "string", "description": "Inquiry message body" },
        "createdAt": { "type": "timestamp", "description": "Submission timestamp" }
      }
    },
    "newsletter_subscribers": {
      "collectionName": "newsletter_subscribers",
      "path": "newsletter_subscribers/{subscriberId}",
      "description": "Product newsletter email subscriber list",
      "fields": {
        "email": { "type": "string", "description": "Subscriber email" },
        "createdAt": { "type": "timestamp", "description": "Subscription timestamp" }
      }
    },
    "bookings": {
      "collectionName": "bookings",
      "path": "bookings/{bookingId}",
      "description": "Appointment bookings scheduled with creators",
      "fields": {
        "hostHandle": { "type": "string", "description": "Host creator handle" },
        "clientEmail": { "type": "string", "description": "Client email" },
        "date": { "type": "string", "description": "Scheduled date" },
        "timeSlot": { "type": "string", "description": "Scheduled time slot" },
        "status": { "type": "string", "description": "confirmed, pending, cancelled" },
        "createdAt": { "type": "timestamp", "description": "Booking timestamp" }
      }
    },
    "orders": {
      "collectionName": "orders",
      "path": "orders/{orderId}",
      "description": "Store purchases, digital downloads, and merchandise",
      "fields": {
        "itemTitle": { "type": "string", "description": "Product or print title" },
        "price": { "type": "number", "description": "Price in USD" },
        "currency": { "type": "string", "description": "Currency code" },
        "buyerEmail": { "type": "string", "description": "Buyer email" },
        "status": { "type": "string", "description": "paid, pending" },
        "createdAt": { "type": "timestamp", "description": "Order timestamp" }
      }
    },
    "page_views": {
      "collectionName": "page_views",
      "path": "page_views/{viewId}",
      "description": "Visitor traffic and analytics telemetry",
      "fields": {
        "path": { "type": "string", "description": "Visited page path" },
        "timestamp": { "type": "timestamp", "description": "Visit timestamp" },
        "userAgent": { "type": "string", "description": "Browser user agent" }
      }
    },
    "link_clicks": {
      "collectionName": "link_clicks",
      "path": "link_clicks/{clickId}",
      "description": "Outbound link clicks and conversions",
      "fields": {
        "linkId": { "type": "string", "description": "Clicked link block ID" },
        "url": { "type": "string", "description": "Target destination URL" },
        "siteHandle": { "type": "string", "description": "Mini-site creator handle" },
        "timestamp": { "type": "timestamp", "description": "Click timestamp" }
      }
    }
  }
}
